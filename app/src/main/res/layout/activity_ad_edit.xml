<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1565C0"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ad_edit_title"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginTop="16dp"
        android:background="#FFFFFF"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvAdEditStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#2E7D32"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ad_edit_hint"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etAdEdit"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:hint="@string/ad_edit_placeholder"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:background="@android:drawable/editbox_background"
            android:scrollbars="vertical" />

    </LinearLayout>

    <Button
        android:id="@+id/btnAdSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        android:text="@string/ad_edit_save"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1565C0"
        android:stateListAnimator="@null" />

    <Button
        android:id="@+id/btnAdResumeCloud"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/ad_edit_resume_cloud"
        android:textSize="15sp"
        android:textColor="#1565C0"
        android:backgroundTint="#E3F2FD"
        android:stateListAnimator="@null" />

    <com.qrscanner.AdFooterView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>